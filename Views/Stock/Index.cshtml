@model List<CarpetStore.Models.ProductStock>

@{
    ViewData["Title"] = "Stock Management";
}

<div style="margin-top: 100px; padding: 20px;">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 style="color: #b8860b;">Stock Management</h2>
            <a asp-controller="Products" asp-action="Index" class="btn btn-outline-primary">
                <i class="fas fa-arrow-left"></i> Back to Products
            </a>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Product</th>
                                <th>Dimension</th>
                                <th>Total Stock</th>
                                <th>Reserved</th>
                                <th>Available</th>
                                <th>Status</th>
                                <th>Last Updated</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var stock in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <img src="@stock.Product.ImageUrl" alt="@stock.Product.Name" 
                                                 style="width: 50px; height: 50px; object-fit: cover; border-radius: 5px; margin-right: 10px;">
                                            <div>
                                                <strong>@stock.Product.Name</strong>
                                                <br>
                                                <small class="text-muted">@stock.Product.Detail</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td><span class="badge bg-primary">@stock.Dimension</span></td>
                                    <td><strong>@stock.StockQuantity</strong></td>
                                    <td><span class="text-warning">@stock.ReservedQuantity</span></td>
                                    <td>
                                        <strong class="@(stock.AvailableStock > 0 ? "text-success" : "text-danger")">
                                            @stock.AvailableStock
                                        </strong>
                                    </td>
                                    <td>
                                        @if (stock.IsInStock)
                                        {
                                            <span class="badge bg-success">In Stock</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Out of Stock</span>
                                        }
                                    </td>
                                    <td>N/A</td>
                                    <td>
                                        <a asp-controller="Stock" asp-action="Manage" asp-route-productId="@stock.ProductId" 
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="fas fa-edit"></i> Manage
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

