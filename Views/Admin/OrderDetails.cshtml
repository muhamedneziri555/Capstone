@model CarpetStore.Models.Order

<div style="margin-top: 100px; padding: 20px;">
    <div class="container-fluid">
        <!-- Header Section -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h2 class="mb-1 text-primary">
                            <i class="fas fa-receipt"></i> Order Details #@Model.Id
                        </h2>
                        <p class="text-muted mb-0">Order placed on @Model.OrderDate.ToString("MMMM dd, yyyy 'at' h:mm tt")</p>
                    </div>
                    <div>
                        <span class="badge fs-6 px-3 py-2 @(Model.OrderStatus switch {
                            "Pending" => "bg-warning",
                            "Processing" => "bg-info", 
                            "Shipped" => "bg-primary",
                            "Delivered" => "bg-success",
                            "Cancelled" => "bg-danger",
                            _ => "bg-secondary"
                        })">@Model.OrderStatus</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <!-- Left Column -->
            <div class="col-lg-8">
                <!-- Order Status Update -->
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-light">
                        <h5 class="card-title mb-0">
                            <i class="fas fa-cog text-primary"></i> Order Management
                        </h5>
                    </div>
                    <div class="card-body">
                        <form asp-action="UpdateOrderStatus" method="post" class="d-flex align-items-center">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <div class="me-3">
                                <label class="form-label fw-bold">Update Status:</label>
                            </div>
                            <select name="status" class="form-select me-3" style="width: auto;">
                                <option value="Pending">🟡 Pending</option>
                                <option value="Processing">🔵 Processing</option>
                                <option value="Shipped">📦 Shipped</option>
                                <option value="Delivered">✅ Delivered</option>
                                <option value="Cancelled">❌ Cancelled</option>
                            </select>
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save"></i> Update Status
                            </button>
                        </form>
                    </div>
                </div>

                <!-- Order Items -->
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-light">
                        <h5 class="card-title mb-0">
                            <i class="fas fa-shopping-bag text-primary"></i> Order Items (@Model.OrderDetails.Count items)
                        </h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="border-0">Product</th>
                                        <th class="border-0">Size</th>
                                        <th class="border-0 text-center">Quantity</th>
                                        <th class="border-0 text-end">Unit Price</th>
                                        <th class="border-0 text-end">Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.OrderDetails)
                                    {
                                        <tr>
                                            <td class="align-middle">
                                                <div class="d-flex align-items-center">
                                                    <div class="me-3">
                                                        @if (!string.IsNullOrEmpty(item.Product?.ImageUrl))
                                                        {
                                                            <img src="@item.Product.ImageUrl" alt="@item.Product?.Name" 
                                                                 class="rounded" style="width: 50px; height: 50px; object-fit: cover;">
                                                        }
                                                        else
                                                        {
                                                            <div class="bg-light rounded d-flex align-items-center justify-content-center" 
                                                                 style="width: 50px; height: 50px;">
                                                                <i class="fas fa-image text-muted"></i>
                                                            </div>
                                                        }
                                                    </div>
                                                    <div>
                                                        <h6 class="mb-0">@item.Product?.Name</h6>
                                                        <small class="text-muted">SKU: #@item.Product?.Id</small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="align-middle">
                                                <span class="badge bg-secondary">@item.Size</span>
                                            </td>
                                            <td class="align-middle text-center">
                                                <span class="fw-bold">@item.Quantity</span>
                                            </td>
                                            <td class="align-middle text-end">
                                                <span class="fw-bold">@item.Price.ToString("C2")</span>
                                            </td>
                                            <td class="align-middle text-end">
                                                <span class="fw-bold text-primary">@((item.Price * item.Quantity).ToString("C2"))</span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="card-footer bg-light">
                            <div class="row">
                                <div class="col-8"></div>
                                <div class="col-4">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <h5 class="mb-0">Order Total:</h5>
                                        <h4 class="mb-0 text-primary">@Model.OrderTotal.ToString("C2")</h4>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Column -->
            <div class="col-lg-4">
                <!-- Customer Information -->
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-light">
                        <h5 class="card-title mb-0">
                            <i class="fas fa-user text-primary"></i> Customer Information
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <h6 class="text-muted mb-1">Full Name</h6>
                            <p class="mb-0 fw-bold">@Model.FirstName @Model.LastName</p>
                        </div>
                        <div class="mb-3">
                            <h6 class="text-muted mb-1">Email Address</h6>
                            <p class="mb-0">
                                <a href="mailto:@Model.Email" class="text-decoration-none">
                                    <i class="fas fa-envelope me-1"></i>@Model.Email
                                </a>
                            </p>
                        </div>
                        <div class="mb-3">
                            <h6 class="text-muted mb-1">Phone Number</h6>
                            <p class="mb-0">
                                <a href="tel:@Model.PhoneNumber" class="text-decoration-none">
                                    <i class="fas fa-phone me-1"></i>@Model.PhoneNumber
                                </a>
                            </p>
                        </div>
                        <div class="mb-0">
                            <h6 class="text-muted mb-1">Shipping Address</h6>
                            <p class="mb-0">
                                <i class="fas fa-map-marker-alt me-1 text-danger"></i>
                                @Model.Address<br>
                                @Model.City, @Model.ZipCode
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Payment Information -->
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-light">
                        <h5 class="card-title mb-0">
                            <i class="fas fa-credit-card text-primary"></i> Payment Information
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <h6 class="text-muted mb-1">Payment Method</h6>
                            <div class="d-flex align-items-center">
                                @if (Model.PaymentMethod.ToLower().Contains("cash") || Model.PaymentMethod.ToLower().Contains("delivery"))
                                {
                                    <i class="fas fa-money-bill-wave text-success me-2"></i>
                                    <span class="badge bg-success fs-6">💰 Cash on Delivery</span>
                                }
                                else if (Model.PaymentMethod.ToLower().Contains("card") || Model.PaymentMethod.ToLower().Contains("credit") || Model.PaymentMethod.ToLower().Contains("debit"))
                                {
                                    <i class="fas fa-credit-card text-primary me-2"></i>
                                    <span class="badge bg-primary fs-6">💳 Credit/Debit Card</span>
                                }
                                else if (Model.PaymentMethod.ToLower().Contains("paypal"))
                                {
                                    <i class="fab fa-paypal text-info me-2"></i>
                                    <span class="badge bg-info fs-6">💳 PayPal</span>
                                }
                                else
                                {
                                    <i class="fas fa-credit-card text-secondary me-2"></i>
                                    <span class="badge bg-secondary fs-6">@Model.PaymentMethod</span>
                                }
                            </div>
                        </div>
                        
                        @if ((Model.PaymentMethod.ToLower() == "card" || Model.PaymentMethod.ToLower() == "credit card" || Model.PaymentMethod.ToLower() == "debit card") && !string.IsNullOrEmpty(Model.CardNumber))
                        {
                            <div class="mb-3">
                                <h6 class="text-muted mb-1">Card Details</h6>
                                <p class="mb-1">
                                    <strong>Card Number:</strong> 
                                    @(Model.CardNumber.Length > 4 ? "**** **** **** " + Model.CardNumber.Substring(Model.CardNumber.Length - 4) : "****")
                                </p>
                                @if (!string.IsNullOrEmpty(Model.CardHolderName))
                                {
                                    <p class="mb-1"><strong>Cardholder:</strong> @Model.CardHolderName</p>
                                }
                                @if (!string.IsNullOrEmpty(Model.ExpiryDate))
                                {
                                    <p class="mb-0"><strong>Expires:</strong> @Model.ExpiryDate</p>
                                }
                            </div>
                        }
                        
                        <div class="mb-0">
                            <h6 class="text-muted mb-1">Payment Status</h6>
                            @if (Model.PaymentStatus.ToLower() == "paid" || Model.PaymentStatus.ToLower() == "completed")
                            {
                                <span class="badge bg-success fs-6">
                                    <i class="fas fa-check-circle me-1"></i>Paid
                                </span>
                            }
                            else if (Model.PaymentStatus.ToLower() == "pending")
                            {
                                <span class="badge bg-warning fs-6">
                                    <i class="fas fa-clock me-1"></i>Pending
                                </span>
                            }
                            else if (Model.PaymentStatus.ToLower() == "failed" || Model.PaymentStatus.ToLower() == "declined")
                            {
                                <span class="badge bg-danger fs-6">
                                    <i class="fas fa-times-circle me-1"></i>Failed
                                </span>
                            }
                            else if (Model.PaymentStatus.ToLower() == "refunded")
                            {
                                <span class="badge bg-secondary fs-6">
                                    <i class="fas fa-undo me-1"></i>Refunded
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-info fs-6">
                                    <i class="fas fa-info-circle me-1"></i>@Model.PaymentStatus
                                </span>
                            }
                        </div>
                    </div>
                </div>

                <!-- Order Summary -->
                <div class="card shadow-sm">
                    <div class="card-header bg-light">
                        <h5 class="card-title mb-0">
                            <i class="fas fa-info-circle text-primary"></i> Order Summary
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-2">
                            <span>Order ID:</span>
                            <span class="fw-bold">#@Model.Id</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Order Date:</span>
                            <span class="fw-bold">@Model.OrderDate.ToString("MMM dd, yyyy")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Items:</span>
                            <span class="fw-bold">@Model.OrderDetails.Count</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Status:</span>
                            <span class="badge @(Model.OrderStatus switch {
                                "Pending" => "bg-warning",
                                "Processing" => "bg-info", 
                                "Shipped" => "bg-primary",
                                "Delivered" => "bg-success",
                                "Cancelled" => "bg-danger",
                                _ => "bg-secondary"
                            })">@Model.OrderStatus</span>
                        </div>
                        <hr>
                        <div class="d-flex justify-content-between">
                            <span class="h6">Total Amount:</span>
                            <span class="h5 text-primary fw-bold">@Model.OrderTotal.ToString("C2")</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="row mt-4">
            <div class="col-12 text-center">
                <a asp-action="Dashboard" class="btn btn-secondary me-2">
                    <i class="fas fa-arrow-left"></i> Back to Dashboard
                </a>
                <button onclick="window.print()" class="btn btn-outline-primary">
                    <i class="fas fa-print"></i> Print Order
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Set the selected option based on the current order status
        document.addEventListener('DOMContentLoaded', function() {
            var select = document.querySelector('select[name="status"]');
            var currentStatus = '@Model.OrderStatus';
            for (var i = 0; i < select.options.length; i++) {
                if (select.options[i].value === currentStatus) {
                    select.selectedIndex = i;
                    break;
                }
            }
        });
    </script>
} 