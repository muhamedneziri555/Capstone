@{
    ViewData["Title"] = "Custom Order Report";
}

<div style="margin-top: 100px; display: flex; flex-direction: column; align-items: center;">
    <h5 class="mbr-section-subtitle mbr-fonts-style align-center mb-0 mt-2 display-5" style="text-align: center; font-size: 2rem; font-weight: 600;">Custom Order Report</h5>

    <div class="card shadow-sm border-0" style="width: 90%; max-width: 800px; background-color: #ffffff; border: 1px solid #e9ecef;">
        <div class="card-body p-4">
            <form method="get" asp-action="Custom">
                <div class="row">
                    <!-- Start Date -->
                    <div class="col-md-3 mb-3">
                        <label for="startDate" class="form-label" style="color: #232323; font-weight: 500;">Start Date</label>
                        <input type="date" class="form-control" id="startDate" name="startDate" 
                               value="@DateTime.Today.AddDays(-30).ToString("yyyy-MM-dd")"
                               style="border-radius: 8px; border: 1px solid #ced4da; background: #ffffff; color: #232323; font-weight: 400;"
                               onfocus="this.style.borderColor='#b8860b'; this.style.boxShadow='0 0 0 0.2rem rgba(184, 134, 11, 0.25)'"
                               onblur="this.style.borderColor='#ced4da'; this.style.boxShadow='none'">
                    </div>
                    
                    <!-- End Date -->
                    <div class="col-md-3 mb-3">
                        <label for="endDate" class="form-label" style="color: #232323; font-weight: 500;">End Date</label>
                        <input type="date" class="form-control" id="endDate" name="endDate" 
                               value="@DateTime.Today.ToString("yyyy-MM-dd")"
                               style="border-radius: 8px; border: 1px solid #ced4da; background: #ffffff; color: #232323; font-weight: 400;"
                               onfocus="this.style.borderColor='#b8860b'; this.style.boxShadow='0 0 0 0.2rem rgba(184, 134, 11, 0.25)'"
                               onblur="this.style.borderColor='#ced4da'; this.style.boxShadow='none'">
                    </div>
                    
                    <!-- Year Selection -->
                    <div class="col-md-3 mb-3">
                        <label for="year" class="form-label" style="color: #232323; font-weight: 500;">Year</label>
                        <select class="form-control" id="year" name="year" 
                                style="border-radius: 8px; border: 1px solid #ced4da; background: #ffffff; color: #232323; font-weight: 400;"
                                onfocus="this.style.borderColor='#b8860b'; this.style.boxShadow='0 0 0 0.2rem rgba(184, 134, 11, 0.25)'"
                                onblur="this.style.borderColor='#ced4da'; this.style.boxShadow='none'"
                                onchange="updateYearRange()">
                            @for (int year = DateTime.Now.Year; year >= DateTime.Now.Year - 5; year--)
                            {
                                if (year == DateTime.Now.Year)
                                {
                                    <option value="@year" selected>@year</option>
                                }
                                else
                                {
                                    <option value="@year">@year</option>
                                }
                            }
                        </select>
                    </div>
                    
                    <!-- Month Selection -->
                    <div class="col-md-3 mb-3">
                        <label for="month" class="form-label" style="color: #232323; font-weight: 500;">Month</label>
                        <select class="form-control" id="month" name="month" 
                                style="border-radius: 8px; border: 1px solid #ced4da; background: #ffffff; color: #232323; font-weight: 400;"
                                onfocus="this.style.borderColor='#b8860b'; this.style.boxShadow='0 0 0 0.2rem rgba(184, 134, 11, 0.25)'"
                                onblur="this.style.borderColor='#ced4da'; this.style.boxShadow='none'"
                                onchange="updateMonthRange()">
                            <option value="0" selected>All Months</option>
                            <option value="1">January</option>
                            <option value="2">February</option>
                            <option value="3">March</option>
                            <option value="4">April</option>
                            <option value="5">May</option>
                            <option value="6">June</option>
                            <option value="7">July</option>
                            <option value="8">August</option>
                            <option value="9">September</option>
                            <option value="10">October</option>
                            <option value="11">November</option>
                            <option value="12">December</option>
                        </select>
                    </div>
                </div>
                
                <div class="text-center">
                    <button type="submit" class="btn btn-lg px-4 py-3" 
                            style="border-radius: 8px; font-weight: 500; background-color: #b8860b; border-color: #b8860b; color: white; transition: all 0.3s ease;"
                            onmouseover="this.style.backgroundColor='#9a6f08'; this.style.borderColor='#9a6f08'; this.style.transform='translateY(-1px)'"
                            onmouseout="this.style.backgroundColor='#b8860b'; this.style.borderColor='#b8860b'; this.style.transform='translateY(0)'">
                        Generate Report
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Quick Date Presets -->
    <div class="row mt-4" style="width: 80%; max-width: 600px;">
        <div class="col-12">
            <div class="card shadow-sm border-0" style="background-color: #ffffff; border: 1px solid #e9ecef;">
                <div class="card-body">
                    <h6 class="mbr-section-subtitle mbr-fonts-style align-center mb-3 display-5" style="text-align: center; color: #232323; font-weight: 500;">Quick Presets</h6>
                    <div class="row text-center">
                        <div class="col-6 col-md-3 mb-2">
                            <button class="btn btn-sm w-100" style="border-radius: 8px; font-weight: 500; background-color: #f8f9fa; border: 1px solid #e9ecef; color: #232323; transition: all 0.3s ease;"
                                    onmouseover="this.style.backgroundColor='#b8860b'; this.style.borderColor='#b8860b'; this.style.color='white'; this.style.transform='translateY(-1px)'"
                                    onmouseout="this.style.backgroundColor='#f8f9fa'; this.style.borderColor='#e9ecef'; this.style.color='#232323'; this.style.transform='translateY(0)'"
                                    onclick="setDateRange(7)">Last 7 Days</button>
                        </div>
                        <div class="col-6 col-md-3 mb-2">
                            <button class="btn btn-sm w-100" style="border-radius: 8px; font-weight: 500; background-color: #f8f9fa; border: 1px solid #e9ecef; color: #232323; transition: all 0.3s ease;"
                                    onmouseover="this.style.backgroundColor='#b8860b'; this.style.borderColor='#b8860b'; this.style.color='white'; this.style.transform='translateY(-1px)'"
                                    onmouseout="this.style.backgroundColor='#f8f9fa'; this.style.borderColor='#e9ecef'; this.style.color='#232323'; this.style.transform='translateY(0)'"
                                    onclick="setDateRange(30)">Last 30 Days</button>
                        </div>
                        <div class="col-6 col-md-3 mb-2">
                            <button class="btn btn-sm w-100" style="border-radius: 8px; font-weight: 500; background-color: #f8f9fa; border: 1px solid #e9ecef; color: #232323; transition: all 0.3s ease;"
                                    onmouseover="this.style.backgroundColor='#b8860b'; this.style.borderColor='#b8860b'; this.style.color='white'; this.style.transform='translateY(-1px)'"
                                    onmouseout="this.style.backgroundColor='#f8f9fa'; this.style.borderColor='#e9ecef'; this.style.color='#232323'; this.style.transform='translateY(0)'"
                                    onclick="setDateRange(90)">Last 90 Days</button>
                        </div>
                        <div class="col-6 col-md-3 mb-2">
                            <button class="btn btn-sm w-100" style="border-radius: 8px; font-weight: 500; background-color: #f8f9fa; border: 1px solid #e9ecef; color: #232323; transition: all 0.3s ease;"
                                    onmouseover="this.style.backgroundColor='#b8860b'; this.style.borderColor='#b8860b'; this.style.color='white'; this.style.transform='translateY(-1px)'"
                                    onmouseout="this.style.backgroundColor='#f8f9fa'; this.style.borderColor='#e9ecef'; this.style.color='#232323'; this.style.transform='translateY(0)'"
                                    onclick="setDateRange(365)">Last Year</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-4">
        <a asp-action="Index" class="btn" style="border-radius: 8px; font-weight: 500; background-color: #f8f9fa; border: 1px solid #e9ecef; color: #232323; transition: all 0.3s ease;"
           onmouseover="this.style.backgroundColor='#b8860b'; this.style.borderColor='#b8860b'; this.style.color='white'; this.style.transform='translateY(-1px)'"
           onmouseout="this.style.backgroundColor='#f8f9fa'; this.style.borderColor='#e9ecef'; this.style.color='#232323'; this.style.transform='translateY(0)'">
            Back to Reports
        </a>
    </div>
</div>

<script>
    function setDateRange(days) {
        const endDate = new Date();
        const startDate = new Date();
        startDate.setDate(endDate.getDate() - days);
        
        document.getElementById('startDate').value = startDate.toISOString().split('T')[0];
        document.getElementById('endDate').value = endDate.toISOString().split('T')[0];
    }

    function updateYearRange() {
        const year = document.getElementById('year').value;
        const month = document.getElementById('month').value;
        
        if (month !== '0') {
            // If month is selected, set to that specific month
            const startDate = new Date(year, month - 1, 1);
            const endDate = new Date(year, month, 0); // Last day of the month
            
            document.getElementById('startDate').value = startDate.toISOString().split('T')[0];
            document.getElementById('endDate').value = endDate.toISOString().split('T')[0];
        } else {
            // If no month selected, set to entire year
            const startDate = new Date(year, 0, 1); // January 1st
            const endDate = new Date(year, 11, 31); // December 31st
            
            document.getElementById('startDate').value = startDate.toISOString().split('T')[0];
            document.getElementById('endDate').value = endDate.toISOString().split('T')[0];
        }
    }

    function updateMonthRange() {
        const year = document.getElementById('year').value;
        const month = document.getElementById('month').value;
        
        if (month !== '0') {
            // If month is selected, set to that specific month
            const startDate = new Date(year, month - 1, 1);
            const endDate = new Date(year, month, 0); // Last day of the month
            
            document.getElementById('startDate').value = startDate.toISOString().split('T')[0];
            document.getElementById('endDate').value = endDate.toISOString().split('T')[0];
        } else {
            // If no month selected, set to entire year
            const startDate = new Date(year, 0, 1); // January 1st
            const endDate = new Date(year, 11, 31); // December 31st
            
            document.getElementById('startDate').value = startDate.toISOString().split('T')[0];
            document.getElementById('endDate').value = endDate.toISOString().split('T')[0];
        }
    }
</script>
