@model List<CarpetStore.Models.WishlistItem>

@{
    ViewData["Title"] = "My Wishlist";
}

<div style="margin-top: 100px; padding: 20px;">
    <div class="container">
        <h2 style="text-align: center; font-size: 2rem; font-weight: 600; margin-bottom: 40px; color: #b8860b;">My Wishlist</h2>

        @if (Model != null && Model.Any())
        {
            <div class="row">
                @foreach (var item in Model)
                {
                    <div class="col-md-4 col-lg-3 mb-4">
                        <div class="card h-100" style="border-radius: 15px; box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);">
                            <img src="@item.Product.ImageUrl" class="card-img-top" alt="@item.Product.Name" style="height: 250px; object-fit: cover; border-radius: 15px 15px 0 0;">
                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title">@item.Product.Name</h5>
                                <p class="card-text text-muted">@item.Product.Detail</p>
                                <div class="mt-auto">
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <span class="h5 text-primary">@item.Product.Price.ToString("C2")</span>
                                        <small class="text-muted">Added @item.DateAdded.ToString("MMM dd, yyyy")</small>
                                    </div>
                                    <div class="d-grid gap-2">
                                        <button class="btn btn-primary" onclick="addToCart(@item.Product.Id)">
                                            <i class="fas fa-shopping-cart"></i> Add to Cart
                                        </button>
                                        <button class="btn btn-outline-danger" onclick="removeFromWishlist(@item.Product.Id)">
                                            <i class="fas fa-heart-broken"></i> Remove
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="fas fa-heart" style="font-size: 4rem; color: #ccc; margin-bottom: 20px;"></i>
                <h4>Your wishlist is empty</h4>
                <p class="text-muted">Start adding products you love to your wishlist!</p>
                <a asp-controller="Products" asp-action="Shop" class="btn btn-primary">Browse Products</a>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        function addToCart(productId) {
            // Redirect to add to cart functionality
            window.location.href = '@Url.Action("AddToShoppingCart", "ShoppingCart")' + '?pId=' + productId;
        }

        function removeFromWishlist(productId) {
            if (confirm('Are you sure you want to remove this item from your wishlist?')) {
                $.ajax({
                    url: '@Url.Action("RemoveFromWishlist", "Wishlist")',
                    type: 'POST',
                    data: { productId: productId },
                    success: function(response) {
                        if (response.success) {
                            location.reload();
                        } else {
                            alert('Error: ' + response.message);
                        }
                    },
                    error: function() {
                        alert('An error occurred while removing the item.');
                    }
                });
            }
        }
    </script>
}








