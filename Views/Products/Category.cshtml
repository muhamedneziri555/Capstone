@model List<CarpetStore.Models.Product>

@{
    var sortBy = ViewBag.SortBy as string ?? "relevance";
    var priceRange = ViewBag.PriceRange as string ?? "";
    var currentCategory = ViewBag.Category as string ?? "";
}

<div style="margin-top: 100px; padding: 20px;">
    <h2 style="text-align: center; font-size: 2rem; font-weight: 600; margin-bottom: 40px; color: #b8860b;">@currentCategory Collection</h2>

    @if (ViewBag.DebugInfo != null)
    {
        <div class="mb-4 text-center" style="color: #1a73e8;">
            <p style="font-size: 1.1rem;">@ViewBag.DebugInfo</p>
        </div>
    }

    <div class="row justify-content-center mb-5">
        <div class="col-md-8">
            <form asp-action="Category" method="get" class="mb-4">
                <input type="hidden" name="category" value="@currentCategory" />
                <div class="row g-3">
                    <div class="col-md-6">
                        <select name="sortBy" class="form-select" style="border-radius: 20px;" onchange="this.form.submit()">
                            <option value="relevance" selected="@(sortBy == "relevance")">Most Relevant</option>
                            <option value="price_asc" selected="@(sortBy == "price_asc")">Price: Low to High</option>
                            <option value="price_desc" selected="@(sortBy == "price_desc")">Price: High to Low</option>
                            <option value="name_asc" selected="@(sortBy == "name_asc")">Name: A to Z</option>
                            <option value="name_desc" selected="@(sortBy == "name_desc")">Name: Z to A</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <select name="priceRange" class="form-select" style="border-radius: 20px;" onchange="this.form.submit()">
                            <option value="">All Prices</option>
                            <option value="0-100" selected="@(priceRange == "0-100")">Under $100</option>
                            <option value="100-500" selected="@(priceRange == "100-500")">$100 - $500</option>
                            <option value="500-1000" selected="@(priceRange == "500-1000")">$500 - $1000</option>
                            <option value="1000+" selected="@(priceRange == "1000+")">Over $1000</option>
                        </select>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="row">
        @if (Model.Any())
        {
            @foreach (var product in Model)
            {
                <div class="col-lg-4 col-md-6 mb-4">
                    <div class="card h-100 shadow-sm" style="border-radius: 15px; transition: transform 0.3s ease;">
                        <div class="card-img-wrapper" style="height: 250px; overflow: hidden; border-radius: 15px 15px 0 0;">
                            @if (!string.IsNullOrEmpty(product.ImageUrl))
                            {
                                <img src="@product.ImageUrl" class="card-img-top h-100 w-100" alt="@product.Name" style="object-fit: cover;" loading="lazy">
                            }
                            else
                            {
                                <div class="card-img-top bg-light d-flex align-items-center justify-content-center h-100" style="height: 250px;">
                                    <i class="fas fa-image text-muted" style="font-size: 3rem;"></i>
                                </div>
                            }
                        </div>
                        <div class="card-body text-center">
                            <h5 class="card-title mb-3" style="color: #b8860b; font-weight: 600;">@product.Name</h5>
                            <p class="card-text text-muted mb-3">@product.Detail</p>
                            
                            <div class="mt-auto">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h6 class="text-primary mb-0">From @product.Price.ToString("C2")</h6>
                                    @if (product.IsTrendingProduct)
                                    {
                                        <span class="badge bg-warning">Trending</span>
                                    }
                                </div>
                                
                                <div class="d-flex gap-2">
                                    <a asp-action="Detail" asp-route-id="@product.Id" class="btn btn-primary flex-fill">
                                        <i class="fas fa-eye"></i> View Details
                                    </a>
                                    
                                    @if (User.Identity.IsAuthenticated)
                                    {
                                        <button class="btn btn-outline-danger wishlist-btn" data-product-id="@product.Id" title="Add to Wishlist">
                                            <i class="fas fa-heart"></i>
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <i class="fas fa-box-open text-muted" style="font-size: 4rem;"></i>
                <h4 class="text-muted mt-3">No Products Found</h4>
                <p class="text-muted">There are no products in the @currentCategory category at the moment.</p>
            </div>
        }
    </div>
</div>

<style>
    .form-select:focus {
        border-color: #b8860b;
        box-shadow: none;
    }

    .form-select {
        border-color: #e9ecef;
    }

    .card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15) !important;
    }

    .wishlist-btn {
        transition: all 0.3s ease;
    }

    .wishlist-btn:hover {
        transform: scale(1.1);
    }

    .badge.bg-warning {
        background-color: #ffc107 !important;
        color: #000 !important;
        font-weight: 600;
    }
</style>

<script>
$(document).ready(function() {
    // Wishlist functionality
    $('.wishlist-btn').click(function() {
        var productId = $(this).data('product-id');
        var button = $(this);
        
        $.post('/Wishlist/ToggleWishlist', { productId: productId })
            .done(function(data) {
                if (data.success) {
                    if (data.isInWishlist) {
                        button.removeClass('btn-outline-danger').addClass('btn-danger');
                        button.find('i').removeClass('far').addClass('fas');
                    } else {
                        button.removeClass('btn-danger').addClass('btn-outline-danger');
                        button.find('i').removeClass('fas').addClass('far');
                    }
                    
                    // Update wishlist count in navigation
                    $('.wishlist-count').text('(' + data.wishlistCount + ')');
                    
                    // Show success message
                    showMessage(data.message, 'success');
                } else {
                    showMessage(data.message, 'error');
                }
            })
            .fail(function() {
                showMessage('Error updating wishlist', 'error');
            });
    });
    
    function showMessage(message, type) {
        var alertClass = type === 'success' ? 'alert-success' : 'alert-danger';
        var alertHtml = '<div class="alert ' + alertClass + ' alert-dismissible fade show" role="alert">' +
                       message +
                       '<button type="button" class="btn-close" data-bs-dismiss="alert"></button>' +
                       '</div>';
        
        $('body').prepend(alertHtml);
        
        setTimeout(function() {
            $('.alert').fadeOut();
        }, 3000);
    }
});
</script> 