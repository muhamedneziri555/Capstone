@model CarpetStore.Models.Product

<div style="margin-top: 100px; padding: 20px;">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-body">
                    <h2 class="text-center mb-4">Edit Product</h2>
                    <div class="mb-4 p-3" style="color: #1a73e8; border-left: 4px solid #1a73e8; background-color: #f8f9fa;">
                        <i class="fas fa-info-circle me-2"></i>
                        <strong>Note:</strong> Choose a category from the list.
                        <br />
                        <strong>Pricing:</strong> Use <em>Price 120x170</em> as the default/base price.
                    </div>
                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <input type="hidden" asp-for="Id" />
                        
                        <div class="form-group mb-3">
                            <label asp-for="Name" class="control-label">Product Name</label>
                            <input asp-for="Name" class="form-control" placeholder="Enter product name (e.g., Acrylic Blue Carpet)" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Detail" class="control-label">Product Details</label>
                            <textarea asp-for="Detail" class="form-control" rows="3" placeholder="Enter product details"></textarea>
                            <span asp-validation-for="Detail" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Category" class="control-label">Category</label>
                            <select asp-for="Category" class="form-select">
                                <option value="">-- Select Category --</option>
                                @foreach (var category in (IEnumerable<CarpetStore.Models.Category>)ViewBag.Categories)
                                {
                                    <option value="@category.Name">@category.Name</option>
                                }
                            </select>
                            <span asp-validation-for="Category" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="ImageUrl" class="control-label">Image URL</label>
                            <input asp-for="ImageUrl" class="form-control" placeholder="Enter image URL" />
                            <span asp-validation-for="ImageUrl" class="text-danger"></span>
                        </div>

                        <!-- Standard Sizes -->
                        <div class="mb-4">
                            <h5 class="mb-3" style="color: #b8860b; border-bottom: 2px solid #b8860b; padding-bottom: 5px;">Standard Sizes</h5>
                            <div class="row">
                                <div class="col-md-4">
                                    <div class="form-group mb-3">
                                        <label asp-for="Price120x170" class="control-label">Price 120x170 (Default)</label>
                                        <input asp-for="Price120x170" class="form-control" />
                                        <span asp-validation-for="Price120x170" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group mb-3">
                                        <label asp-for="Price150x220" class="control-label">Price 150x220</label>
                                        <input asp-for="Price150x220" class="form-control" />
                                        <span asp-validation-for="Price150x220" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group mb-3">
                                        <label asp-for="Price200x290" class="control-label">Price 200x290</label>
                                        <input asp-for="Price200x290" class="form-control" />
                                        <span asp-validation-for="Price200x290" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Custom Sizes Section -->
                        <div class="mb-4">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5 style="color: #b8860b; border-bottom: 2px solid #b8860b; padding-bottom: 5px; margin: 0;">Custom Sizes</h5>
                                <button type="button" class="btn btn-success btn-sm" data-bs-toggle="modal" data-bs-target="#addSizeModal">
                                    <i class="fas fa-plus me-1"></i>Add New Size
                                </button>
                            </div>

                            @if (ViewBag.CustomSizes != null && ((IEnumerable<CarpetStore.Models.ProductSize>)ViewBag.CustomSizes).Any())
                            {
                                <div class="table-responsive">
                                    <table class="table table-striped">
                                        <thead>
                                            <tr>
                                                <th>Size Name</th>
                                                <th>Price</th>
                                                <th>Description</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var size in (IEnumerable<CarpetStore.Models.ProductSize>)ViewBag.CustomSizes)
                                            {
                                                <tr>
                                                    <td><strong>@size.SizeName</strong></td>
                                                    <td>@size.Price.ToString("C2")</td>
                                                    <td>@(size.Description ?? "No description")</td>
                                                    <td>
                                                        <button type="button" class="btn btn-warning btn-sm me-1" onclick="editSize(@size.Id, '@size.SizeName', @size.Price, '@(size.Description ?? "")')">
                                                            <i class="fas fa-edit"></i>
                                                        </button>
                                                        <form asp-action="DeleteCustomSize" method="post" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this size?')">
                                                            <input type="hidden" name="sizeId" value="@size.Id" />
                                                            <button type="submit" class="btn btn-danger btn-sm">
                                                                <i class="fas fa-trash"></i>
                                                            </button>
                                                        </form>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-info">
                                    <i class="fas fa-info-circle me-2"></i>No custom sizes added yet. Click "Add New Size" to create custom sizes for this product.
                                </div>
                            }
                        </div>


                        <div class="form-group mb-3">
                            <div class="form-check">
                                <input asp-for="IsTrendingProduct" class="form-check-input" />
                                <label asp-for="IsTrendingProduct" class="form-check-label">Trending Product</label>
                            </div>
                        </div>

                        <div class="form-group text-center mt-4 d-flex justify-content-center gap-3">
                            <button type="submit" class="btn btn-outline-warning px-4 py-2" style="border-radius: 25px; transition: all 0.3s ease; box-shadow: 0 2px 5px rgba(0,0,0,0.1);">
                                <i class="fas fa-save me-2"></i>Save Changes
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary px-4 py-2" style="border-radius: 25px; transition: all 0.3s ease; box-shadow: 0 2px 5px rgba(0,0,0,0.1);">
                                <i class="fas fa-arrow-left me-2"></i>Back to List
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add Size Modal -->
<div class="modal fade" id="addSizeModal" tabindex="-1" aria-labelledby="addSizeModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addSizeModalLabel">Add New Size</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="AddCustomSize" method="post">
                <div class="modal-body">
                    <input type="hidden" name="productId" value="@Model.Id" />
                    <div class="mb-3">
                        <label for="sizeName" class="form-label">Size Name</label>
                        <input type="text" class="form-control" id="sizeName" name="sizeName" placeholder="e.g., 100x150, 180x250, Custom Size" required>
                    </div>
                    <div class="mb-3">
                        <label for="price" class="form-label">Price</label>
                        <input type="number" class="form-control" id="price" name="price" step="0.01" min="0" placeholder="0.00" required>
                    </div>
                    <div class="mb-3">
                        <label for="description" class="form-label">Description (Optional)</label>
                        <textarea class="form-control" id="description" name="description" rows="2" placeholder="Additional details about this size"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">Add Size</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Size Modal -->
<div class="modal fade" id="editSizeModal" tabindex="-1" aria-labelledby="editSizeModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editSizeModalLabel">Edit Size</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="UpdateCustomSize" method="post">
                <div class="modal-body">
                    <input type="hidden" id="editSizeId" name="sizeId" />
                    <div class="mb-3">
                        <label for="editSizeName" class="form-label">Size Name</label>
                        <input type="text" class="form-control" id="editSizeName" name="sizeName" required>
                    </div>
                    <div class="mb-3">
                        <label for="editPrice" class="form-label">Price</label>
                        <input type="number" class="form-control" id="editPrice" name="price" step="0.01" min="0" required>
                    </div>
                    <div class="mb-3">
                        <label for="editDescription" class="form-label">Description (Optional)</label>
                        <textarea class="form-control" id="editDescription" name="description" rows="2"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning">Update Size</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        function editSize(sizeId, sizeName, price, description) {
            document.getElementById('editSizeId').value = sizeId;
            document.getElementById('editSizeName').value = sizeName;
            document.getElementById('editPrice').value = price;
            document.getElementById('editDescription').value = description;
            
            var editModal = new bootstrap.Modal(document.getElementById('editSizeModal'));
            editModal.show();
        }
    </script>
}