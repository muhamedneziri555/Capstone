@model List<CarpetStore.Models.Product>

@{
    var sortBy = ViewBag.SortBy as string ?? "relevance";
    var priceRange = ViewBag.PriceRange as string ?? "";
    var category = ViewBag.Category as string ?? "";
    var size = ViewBag.Size as string ?? "";
}

<div style="margin-top: 100px; padding: 20px;">
    <h2 style="text-align: center; font-size: 2rem; font-weight: 600; margin-bottom: 40px; color: #b8860b;">All Products</h2>
    
    @if (ViewBag.ResultsCount != null)
    {
        <p class="text-center text-muted mb-4">Found <strong>@ViewBag.ResultsCount</strong> product(s)</p>
    }

    <div class="row justify-content-center mb-5">
        <div class="col-md-8">
            <form asp-action="Search" method="get" class="mb-4">
                <div class="input-group input-group-lg shadow-sm mb-3 position-relative">
                    <input type="text" name="searchTerm" id="searchInput" class="form-control border-end-0" placeholder="Search products..." value="@ViewBag.SearchTerm" style="border-radius: 30px 0 0 30px;" autocomplete="off">
                    <button type="submit" class="btn btn-primary px-4" style="border-radius: 0 30px 30px 0; background-color: #b8860b; border-color: #b8860b;">
                        <span class="mobi-mbri mobi-mbri-search mbr-iconfont mbr-iconfont-btn"></span>
                        Search
                    </button>
                    <!-- Search suggestions dropdown -->
                    <div id="searchSuggestions" class="position-absolute w-100" style="top: 100%; z-index: 1000; display: none; background: white; border: 1px solid #ddd; border-radius: 0 0 10px 10px; box-shadow: 0 4px 6px rgba(0,0,0,0.1);">
                        <ul id="suggestionsList" class="list-unstyled mb-0"></ul>
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-md-3">
                        <select name="sortBy" class="form-select" style="border-radius: 20px;">
                            <option value="relevance" selected="@(sortBy == "relevance")">Most Relevant</option>
                            <option value="price_asc" selected="@(sortBy == "price_asc")">Price: Low to High</option>
                            <option value="price_desc" selected="@(sortBy == "price_desc")">Price: High to Low</option>
                            <option value="name_asc" selected="@(sortBy == "name_asc")">Name: A to Z</option>
                            <option value="name_desc" selected="@(sortBy == "name_desc")">Name: Z to A</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <select name="priceRange" class="form-select" style="border-radius: 20px;">
                            <option value="">All Prices</option>
                            <option value="0-100" selected="@(priceRange == "0-100")">Under $100</option>
                            <option value="100-500" selected="@(priceRange == "100-500")">$100 - $500</option>
                            <option value="500-1000" selected="@(priceRange == "500-1000")">$500 - $1000</option>
                            <option value="1000+" selected="@(priceRange == "1000+")">Over $1000</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <select name="category" class="form-select" style="border-radius: 20px;">
                            <option value="">All Categories</option>
                            @foreach (var cat in (IEnumerable<string>)ViewBag.AllCategories)
                            {
                                <option value="@cat" selected="@(category == cat)">@cat</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <select name="size" class="form-select" style="border-radius: 20px;">
                            <option value="">All Sizes</option>
                            @foreach (var sizeOption in (IEnumerable<string>)ViewBag.AllSizes)
                            {
                                <option value="@sizeOption" selected="@(size == sizeOption)">@sizeOption cm</option>
                            }
                        </select>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="row">
        @foreach (var product in Model)
        {
            <div class="col-lg-4 col-md-6 mb-4">
                <div class="card h-100 shadow-sm" style="border-radius: 15px; transition: transform 0.3s ease;">
                    <div class="card-img-wrapper" style="height: 250px; overflow: hidden; border-radius: 15px 15px 0 0;">
                        @if (!string.IsNullOrEmpty(product.ImageUrl))
                        {
                            <img src="@product.ImageUrl" class="card-img-top h-100 w-100" alt="@product.Name" style="object-fit: cover;" loading="lazy">
                        }
                        else
                        {
                            <div class="card-img-top bg-light d-flex align-items-center justify-content-center h-100" style="height: 250px;">
                                <i class="fas fa-image text-muted" style="font-size: 3rem;"></i>
                            </div>
                        }
                    </div>
                    <div class="card-body text-center">
                        <h5 class="card-title mb-3" style="color: #b8860b; font-weight: 600;">@product.Name</h5>
                        <p class="card-text text-muted mb-3">@product.Detail</p>
                        
                        <div class="mt-auto">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h6 class="text-primary mb-0">From @product.Price.ToString("C2")</h6>
                                @if (product.IsTrendingProduct)
                                {
                                    <span class="badge bg-warning">Trending</span>
                                }
                            </div>
                            
                            <div class="d-flex gap-2">
                                <a asp-action="Detail" asp-route-id="@product.Id" class="btn btn-primary flex-fill">
                                    <i class="fas fa-eye"></i> View Details
                                </a>
                                
                                @if (User.Identity.IsAuthenticated)
                                {
                                    <button class="btn btn-outline-danger wishlist-btn" data-product-id="@product.Id" title="Add to Wishlist">
                                        <i class="fas fa-heart"></i>
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
    
    <!-- Pagination -->
    @if (ViewBag.TotalPages > 1)
    {
        <nav aria-label="Product pagination" class="mt-4">
            <ul class="pagination justify-content-center">
                @if (ViewBag.Page > 1)
                {
                    <li class="page-item">
                        <a class="page-link" href="?page=@(ViewBag.Page - 1)&sortBy=@ViewBag.SortBy&priceRange=@ViewBag.PriceRange&category=@ViewBag.Category&size=@ViewBag.Size">Previous</a>
                    </li>
                }
                
                @for (int i = Math.Max(1, ViewBag.Page - 2); i <= Math.Min(ViewBag.TotalPages, ViewBag.Page + 2); i++)
                {
                    <li class="page-item @(i == ViewBag.Page ? "active" : "")">
                        <a class="page-link" href="?page=@i&sortBy=@ViewBag.SortBy&priceRange=@ViewBag.PriceRange&category=@ViewBag.Category&size=@ViewBag.Size">@i</a>
                    </li>
                }
                
                @if (ViewBag.Page < ViewBag.TotalPages)
                {
                    <li class="page-item">
                        <a class="page-link" href="?page=@(ViewBag.Page + 1)&sortBy=@ViewBag.SortBy&priceRange=@ViewBag.PriceRange&category=@ViewBag.Category&size=@ViewBag.Size">Next</a>
                    </li>
                }
            </ul>
        </nav>
        
        <div class="text-center text-muted mt-2">
            Showing @((ViewBag.Page - 1) * ViewBag.PageSize + 1) to @(Math.Min(ViewBag.Page * ViewBag.PageSize, ViewBag.TotalCount)) of @ViewBag.TotalCount products
        </div>
    }
</div>

<style>
    .input-group .form-control:focus {
        box-shadow: none;
        border-color: #b8860b;
    }
    
    .btn-primary:hover {
        background-color: #9b6f0a !important;
        border-color: #9b6f0a !important;
    }

    .form-select:focus {
        border-color: #b8860b;
        box-shadow: none;
    }

    .form-select {
        border-color: #e9ecef;
    }

    #searchSuggestions {
        max-height: 200px;
        overflow-y: auto;
    }

    #suggestionsList li {
        padding: 8px 15px;
        cursor: pointer;
        border-bottom: 1px solid #f0f0f0;
    }

    #suggestionsList li:hover {
        background-color: #f8f9fa;
    }

    #suggestionsList li:last-child {
        border-bottom: none;
    }

    .suggestion-highlight {
        background-color: #fff3cd;
        font-weight: bold;
    }

    .card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15) !important;
    }

    .wishlist-btn {
        transition: all 0.3s ease;
    }

    .wishlist-btn:hover {
        transform: scale(1.1);
    }

    .badge.bg-warning {
        background-color: #ffc107 !important;
        color: #000 !important;
        font-weight: 600;
    }
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const searchInput = document.getElementById('searchInput');
    const suggestionsDiv = document.getElementById('searchSuggestions');
    const suggestionsList = document.getElementById('suggestionsList');
    let debounceTimer;

    // Debounced search suggestions
    searchInput.addEventListener('input', function() {
        clearTimeout(debounceTimer);
        const query = this.value.trim();
        
        if (query.length < 2) {
            suggestionsDiv.style.display = 'none';
            return;
        }

        debounceTimer = setTimeout(() => {
            fetchSearchSuggestions(query);
        }, 300);
    });

    // Hide suggestions when clicking outside
    document.addEventListener('click', function(e) {
        if (!searchInput.contains(e.target) && !suggestionsDiv.contains(e.target)) {
            suggestionsDiv.style.display = 'none';
        }
    });

    // Handle suggestion clicks
    suggestionsList.addEventListener('click', function(e) {
        if (e.target.tagName === 'LI') {
            searchInput.value = e.target.textContent;
            suggestionsDiv.style.display = 'none';
            searchInput.form.submit();
        }
    });

    // Handle keyboard navigation
    searchInput.addEventListener('keydown', function(e) {
        const suggestions = suggestionsList.querySelectorAll('li');
        const activeSuggestion = suggestionsList.querySelector('.active');
        let activeIndex = -1;

        if (activeSuggestion) {
            activeIndex = Array.from(suggestions).indexOf(activeSuggestion);
        }

        if (e.key === 'ArrowDown') {
            e.preventDefault();
            if (activeIndex < suggestions.length - 1) {
                if (activeSuggestion) activeSuggestion.classList.remove('active');
                suggestions[activeIndex + 1].classList.add('active');
            }
        } else if (e.key === 'ArrowUp') {
            e.preventDefault();
            if (activeIndex > 0) {
                if (activeSuggestion) activeSuggestion.classList.remove('active');
                suggestions[activeIndex - 1].classList.add('active');
            }
        } else if (e.key === 'Enter' && activeSuggestion) {
            e.preventDefault();
            searchInput.value = activeSuggestion.textContent;
            suggestionsDiv.style.display = 'none';
            searchInput.form.submit();
        } else if (e.key === 'Escape') {
            suggestionsDiv.style.display = 'none';
        }
    });

    function fetchSearchSuggestions(query) {
        fetch(`/Products/GetSearchSuggestions?term=${encodeURIComponent(query)}`)
            .then(response => response.json())
            .then(suggestions => {
                displaySuggestions(suggestions, query);
            })
            .catch(error => {
                console.error('Error fetching suggestions:', error);
                suggestionsDiv.style.display = 'none';
            });
    }

    function displaySuggestions(suggestions, query) {
        if (suggestions.length === 0) {
            suggestionsDiv.style.display = 'none';
            return;
        }

        suggestionsList.innerHTML = '';
        suggestions.forEach(suggestion => {
            const li = document.createElement('li');
            li.innerHTML = highlightMatch(suggestion, query);
            suggestionsList.appendChild(li);
        });

        suggestionsDiv.style.display = 'block';
    }

    function highlightMatch(text, query) {
        const regex = new RegExp(`(${query})`, 'gi');
        return text.replace(regex, '<span class="suggestion-highlight">$1</span>');
    }

    // Wishlist functionality
    $('.wishlist-btn').click(function() {
        var productId = $(this).data('product-id');
        var button = $(this);
        
        $.post('/Wishlist/ToggleWishlist', { productId: productId })
            .done(function(data) {
                if (data.success) {
                    if (data.isInWishlist) {
                        button.removeClass('btn-outline-danger').addClass('btn-danger');
                        button.find('i').removeClass('far').addClass('fas');
                    } else {
                        button.removeClass('btn-danger').addClass('btn-outline-danger');
                        button.find('i').removeClass('fas').addClass('far');
                    }
                    
                    // Update wishlist count in navigation
                    $('.wishlist-count').text('(' + data.wishlistCount + ')');
                    
                    // Show success message
                    showMessage(data.message, 'success');
                } else {
                    showMessage(data.message, 'error');
                }
            })
            .fail(function() {
                showMessage('Error updating wishlist', 'error');
            });
    });
    
    function showMessage(message, type) {
        var alertClass = type === 'success' ? 'alert-success' : 'alert-danger';
        var alertHtml = '<div class="alert ' + alertClass + ' alert-dismissible fade show" role="alert">' +
                       message +
                       '<button type="button" class="btn-close" data-bs-dismiss="alert"></button>' +
                       '</div>';
        
        $('body').prepend(alertHtml);
        
        setTimeout(function() {
            $('.alert').fadeOut();
        }, 3000);
    }
});
</script> 